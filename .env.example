# Backup Manager configuration
# Copy to .env and edit for your system

# Web UI port
PORT=8081

# Timezone
TZ=America/Chicago

# Source: mount point(s) to browse for backup sources
# These paths are mounted read-only into the container
SOURCE_MOUNT=/McRubesDesktop
SOURCE_ROOTS=/McRubesDesktop,/Media

# Destination: where backups are written
DEST_MOUNT=/Media
DEST_ROOTS=/Media
DEFAULT_DEST=/Media/Backups/mcrubesdesktop

# Path to the generated backup script on the host
# This file will be created/overwritten by the app
SCRIPT_PATH=/root/backup-desktop.sh
